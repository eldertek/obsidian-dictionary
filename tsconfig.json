{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "svelte"],
    "baseUrl": ".",
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "paths": {
      "src": ["src/*"]
    },
    "lib": [
      "dom",
      "es2020"
    ],
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules/*"],
}
